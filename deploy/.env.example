# deploy/.env 로 복사해서 값을 채운다. .env 자체는 커밋하지 않는다.

# ECR 이미지 주소 — 계정ID·리전은 실제 값으로
APP_IMAGE=<계정ID>.dkr.ecr.ap-northeast-2.amazonaws.com/sorisaegim:latest

# 서비스 도메인. 보유 도메인이면 그대로, 없으면 DuckDNS 서브도메인
# 예) sorisaegim.duckdns.org
SITE_ADDRESS=<도메인>

# 인증서 만료 알림을 받을 주소 (Let's Encrypt에 전달된다)
TLS_EMAIL=<이메일>
